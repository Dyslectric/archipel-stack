PORT=8788
HOST=127.0.0.1
# Exact proxy peer IP, or a deliberate CIDR/list. Empty disables forwarded-header trust.
# Example for a Docker proxy: TRUSTED_PROXY=172.20.0.2
TRUSTED_PROXY=
BASE_URL=http://127.0.0.1:8788
DATABASE_PATH=./data/archipel.sqlite
# npm run dev enables three local test personas, only on loopback HTTP.
# npm start disables them unless DEV_AUTH=true is explicitly set.
DEV_AUTH=false
# Register this callback on your provider: BASE_URL/auth/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# none, client_secret_basic, or client_secret_post
OIDC_AUTH_METHOD=none
# HTTP OIDC is allowed only on loopback and only in development mode.
# Administrators are exact OIDC subjects at the configured issuer.
ADMIN_SUBJECTS=
# Initial policy for a database without an existing setting. Afterwards use Instance administration.
REGISTRATION_MODE=open
# npm run setup generates Compose selections and .env.container for containers.
# Compose 2.30+ is required for literal raw environment values.
SETUP_MODE=local
COMPOSE_FILE=compose.yaml:compose.local.yaml
PROXY_NETWORK=
TRAEFIK_HOST=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=
