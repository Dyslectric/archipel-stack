PORT=8788
HOST=0.0.0.0
# Exact proxy peer IP, or a deliberate CIDR/list. Empty disables forwarded-header trust.
# Example for a Docker proxy: TRUSTED_PROXY=172.20.0.2
TRUSTED_PROXY=
BASE_URL=http://127.0.0.1:8788
DATABASE_PATH=/app/data/archipel.sqlite
# PostgreSQL instead of the SQLite file. Outside Compose, give its address here; the password
# may be left out of it and supplied as PGPASSWORD. See docs/deployment.md to move an instance over.
# DATABASE_URL=postgres://archipel:password@127.0.0.1:5432/archipel
# sqlite or postgres. With postgres, setup adds compose.postgres.yaml, which runs the database
# beside the application, and keeps its generated password in .env.postgres.
DATABASE=sqlite
# Containers use OIDC authentication; development personas stay disabled.
DEV_AUTH=false
# Register this callback on your provider: BASE_URL/auth/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# none, client_secret_basic, or client_secret_post
OIDC_AUTH_METHOD=none
# Administrators are exact OIDC subjects at the configured issuer.
ADMIN_SUBJECTS=
# Initial policy for a database without an existing setting. Afterwards use Instance administration.
REGISTRATION_MODE=open
# Requests per minute from one client; empty keeps the defaults shown.
# RATE_LIMIT_API=300
# RATE_LIMIT_AUTH=30
# RATE_LIMIT_MEDIA=600
# RATE_LIMIT_FEDERATION=120
# Outbound federation deliveries go out in rounds: how many per round across all peers, and
# the milliseconds between rounds. These are the defaults; Instance federation in the settings
# changes both while the instance runs. FEDERATION_PEER_SEND_RATE caps one peer per minute
# (0 is unlimited); keep it below the peer's RATE_LIMIT_FEDERATION.
# FEDERATION_SEND_RATE=20
# FEDERATION_SEND_INTERVAL=1000
# Independent deliveries in flight (1–32); recipient order is preserved.
# FEDERATION_SEND_CONCURRENCY=4
# First native Rust chat slice (PostgreSQL only, optional).
# NATIVE_CHAT_URL=http://127.0.0.1:8870
# NATIVE_BRIDGE_SECRET=generate-a-random-base64url-secret-at-least-43-characters
# Native service: isolated processes and PostgreSQL connections per process.
# NATIVE_WORKERS=4
# NATIVE_DATABASE_POOL=4
# Concurrent operations per channel, less than the per-worker DB pool.
# NATIVE_CHANNEL_CONCURRENCY=2
# FEDERATION_PEER_SEND_RATE=100
# Prosody XMPP backend. Setup adds compose.xmpp.yaml when a domain is supplied.
# Use a DNS domain covered by your certificates; channels use channels.<domain>.
XMPP_DOMAIN=
XMPP_BIND_ADDRESS=0.0.0.0
# STARTTLS client and server-to-server listener ports; publish matching DNS SRV records.
XMPP_CLIENT_PORT=5222
XMPP_SERVER_PORT=5269
XMPP_CERTS_PATH=./data/xmpp-certs
# DNS-only hostname of this machine; the target of the SRV records setup prints.
XMPP_SRV_TARGET=
# manual, acme (lego; DNS credentials live in .env.acme), or traefik (existing resolver).
XMPP_CERT_SOURCE=manual
XMPP_ACME_EMAIL=
XMPP_ACME_ACCEPT_TOS=false
# dns or http (direct port 80 in container mode; existing Traefik in traefik mode)
XMPP_ACME_CHALLENGE=dns
# Separate from the app's HTTPS TRAEFIK_ENTRYPOINT; must serve public port 80.
XMPP_ACME_HTTP_ENTRYPOINT=web
XMPP_ACME_DNS_PROVIDER=
XMPP_TRAEFIK_ACME_DIR=
XMPP_TRAEFIK_ACME_NAME=acme.json
# Random secret generated by setup and kept in .env.container.
XMPP_BRIDGE_SECRET=
# python3 scripts/setup.py generates Compose selections and .env.container.
# Compose 2.30+ is required for literal raw environment values.
SETUP_MODE=container
COMPOSE_FILE=compose.yaml:compose.local.yaml
PROXY_NETWORK=
TRAEFIK_HOST=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=
