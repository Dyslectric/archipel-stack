{
  "name": "archipel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build:client && node --env-file-if-exists=.env --import tsx --input-type=module -e \"process.env.DEV_AUTH='true'; await import('./src/server.ts')\"",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build:client": "vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "test:xmpp": "node --import tsx test/xmpp-integration.mjs",
    "identities": "node --env-file-if-exists=.env --import tsx scripts/identities.ts",
    "build": "npm run check && npm run build:client",
    "build:server": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "gemoji": "8.1.0",
    "helmet": "8.3.0",
    "ipaddr.js": "2.2.0",
    "openid-client": "6.8.8",
    "twemoji-colr-font": "15.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@xmpp/client": "^0.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
