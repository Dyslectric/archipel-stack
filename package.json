{
  "name": "archipel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build:client && node --env-file-if-exists=.env --import tsx --input-type=module -e \"process.env.DEV_AUTH='true'; await import('./src/server.ts')\"",
    "start": "node --env-file-if-exists=.env build/src/server.js",
    "build:client": "vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "test:xmpp": "node --import tsx test/xmpp-integration.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:benchmark": "node --test test/benchmark.test.mjs",
    "benchmark:diagnose": "node --import tsx scripts/diagnose-scale.ts",
    "benchmark:five": "node scripts/benchmark-five.mjs",
    "benchmark:fwdxp": "node scripts/benchmark-fwdxp.mjs",
    "benchmark:postgres": "node --import tsx scripts/benchmark-postgres.ts",
    "benchmark:postgres-discovery": "node --import tsx scripts/benchmark-postgres-discovery.ts",
    "benchmark:native": "node --import tsx scripts/benchmark-native.ts",
    "identities": "node --env-file-if-exists=.env --import tsx scripts/identities.ts",
    "migrate:postgres": "node --env-file-if-exists=.env --import tsx scripts/migrate-postgres.ts",
    "build": "npm run check && npm run build:client && npm run build:server",
    "build:server": "tsc -p tsconfig.build.json && node scripts/copy-runtime.mjs",
    "build:native": "cargo build --manifest-path native/Cargo.toml --locked --release -j 4"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "gemoji": "8.1.0",
    "helmet": "8.3.0",
    "ipaddr.js": "2.2.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "twemoji-colr-font": "15.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@xmpp/client": "^0.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
